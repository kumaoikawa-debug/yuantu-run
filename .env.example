# 远拓运营中心 · 环境变量配置
# 复制此文件为 .env，然后填入你的值

# 公众号 AppId（公众号后台 → 设置与开发 → 基本配置 → 开发者ID）
APPID=wx95eca19690094ee6

# 公众号 AppSecret（公众号后台 → 设置与开发 → 基本配置 → 开发者密码）
APPSECRET=你的AppSecret

# 初始管理员的微信 openid
# 第一次用微信打开后台时会显示你的 openid，复制到这里然后重启服务
ADMIN_OPENID=

# 服务端口（默认 3000，一般不用改）
PORT=3000

# 微信公众号「网页授权域名」验证文件内容
# 在公众号后台下载 MP_verify_xxx.txt，把文件里的字符串填到这里
MP_VERIFY_CONTENT=

# ===== 数据持久化 =====
# 方式一（推荐，零额外套餐费）：用 CloudBase 云数据库 + 云存储
#   填 TCB_ENV 即可，数据自动落到云数据库(kv集合)和云存储，重启/部署都不丢。
#   环境ID 在 CloudBase 控制台 → 环境 → 环境设置 查看（形如 yuantu-xxxx）。
#   大多数情况下云托管容器内会自动鉴权，无需填密钥；
#   若部署后报鉴权错误，再补充下面两个密钥（环境设置 → 访问密钥）。
TCB_ENV=
# TCB_SECRET_ID=
# TCB_SECRET_KEY=

# 方式二（兜底，仅未填 TCB_ENV 时生效）：本地磁盘目录
# 容器盘是临时的，实例重建会清空，仅适合本地开发/沙箱。
DATA_DIR=
