# 远拓运营中心 · 环境变量配置
# 复制此文件为 .env，然后填入你的值

# 公众号 AppId（公众号后台 → 设置与开发 → 基本配置 → 开发者ID）
APPID=wx95eca19690094ee6

# 公众号 AppSecret（公众号后台 → 设置与开发 → 基本配置 → 开发者密码）
APPSECRET=你的AppSecret

# 初始管理员的微信 openid
# 第一次用微信打开后台时会显示你的 openid，复制到这里然后重启服务
ADMIN_OPENID=

# 服务端口（默认 3000，一般不用改）
PORT=3000

# 微信公众号「网页授权域名」验证文件内容
# 在公众号后台下载 MP_verify_xxx.txt，把文件里的字符串填到这里
MP_VERIFY_CONTENT=
